# Copy this file to .env for local development. .env is Git-ignored.
# Keep the provider disabled until you are ready to make DeepSeek API calls.
CHATBI_DATABASE_URL=sqlite:///data/local/chatbi.sqlite
CHATBI_LLM_PROVIDER=disabled
CHATBI_PUBLIC_DEMO=false
CHATBI_CORS_ORIGINS=http://127.0.0.1:5173
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
